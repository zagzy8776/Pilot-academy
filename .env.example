# Neon dashboard > Connection details > pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# mock | live (mock = clearly-labelled demo, no real charge)
STRIPE_MODE=mock
MOCK_WEBHOOK_SECRET=dev-mock-secret
# deferred | mock-employer | mock-candidate — decide payer before launch, no code change
FEE_PAYER_MODE=deferred
# recruiter dashboard token (leave empty for local dev convenience)
ADMIN_TOKEN=
